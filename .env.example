# Copier en .env et remplir. Le fichier .env est ignoré par git.
GEMMW_ENV=dev
GEMMW_DB_PATH=data/gemmw.db

# Payhip / Etsy : exports manuels pour l'instant, API plus tard
PAYHIP_API_KEY=
ETSY_API_KEY=

# Assistants (vague 2) : un seul fournisseur à la fois, via LiteLLM
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Alertes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
