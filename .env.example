# Copier en .env et remplir. Le fichier .env est ignoré par git.
GEMMW_ENV=dev
GEMMW_DB_PATH=data/gemmw.db
# Sel du hachage des emails (une longue chaîne au hasard, à ne jamais changer ensuite)
GEMMW_SEL_ACHETEUSES=

# Payhip : exports manuels pour l'instant
PAYHIP_API_KEY=
# Etsy : clé d'application (etsy.com/developers). Sert à la collecte des annonces concurrentes.
# Sans clé, la collecte Etsy est sautée. Sur GitHub : secret ETSY_API_KEY.
ETSY_API_KEY=

# Assistants (vague 2) : un seul fournisseur à la fois, via LiteLLM
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Alertes de prix sur Telegram (facultatif). Sur GitHub : secrets du même nom.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Générateur au prénom (service web)
# Clé partagée avec la boutique (une longue chaîne au hasard)
GEMMW_API_CLE=
# Dossier des livrets sources, un PDF par référence (ex. automne.pdf). Jamais sur GitHub.
GEMMW_LIVRETS_DIR=livrets
# Facultatif : fichier .ttf ou .otf de la police du livret
GEMMW_POLICE=
